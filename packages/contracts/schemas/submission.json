{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission",
  "type": "object",
  "required": [
    "id",
    "task_id",
    "student_id",
    "attempt_number",
    "source_type",
    "submitted_at",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "task_id": { "type": "string" },
    "student_id": { "type": "string" },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["EDITOR", "GITHUB", "BOTH"]
    },
    "code": {
      "type": ["string", "null"]
    },
    "github_repository": {
      "type": ["string", "null"]
    },
    "github_branch": {
      "type": ["string", "null"]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "EVALUATING", "EVALUATED", "FAILED"]
    }
  }
}
